<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <Style src="TableEditorWindow.uss" />

    <ui:VisualElement name="table-editor" class="table-editor">
        <uie:Toolbar class="table-editor__toolbar">
            <ui:VisualElement class="table-editor__toolbar-spacer" />

            <uie:ToolbarButton
                name="table-editor__search-button"
                class="table-editor__toolbar-icon-button"
                tooltip="Search cell contents (Ctrl+F)">
                <ui:VisualElement class="table-editor__icon table-editor__icon--search" />
            </uie:ToolbarButton>
        </uie:Toolbar>

        <!-- 찾기·바꾸기 바: 왼쪽 펼치기 버튼으로 바꾸기 줄을 연다. 아이콘은 Material Symbols(Icons/). -->
        <ui:VisualElement
            name="table-editor__search-bar"
            class="table-editor__search-bar table-editor__search-bar--hidden">
            <ui:Button
                name="table-editor__search-expand-button"
                class="table-editor__icon-button table-editor__search-expand-button"
                tooltip="Toggle replace">
                <ui:VisualElement class="table-editor__icon table-editor__icon--chevron" />
            </ui:Button>

            <ui:VisualElement class="table-editor__search-rows">
                <ui:VisualElement class="table-editor__search-row">
                    <ui:VisualElement class="table-editor__search-input">
                        <ui:TextField name="table-editor__search-field" class="table-editor__search-field" />
                        <ui:VisualElement class="table-editor__search-input-options">
                            <ui:Button
                                name="table-editor__search-case-toggle"
                                class="table-editor__icon-button table-editor__option-toggle"
                                tooltip="Match case">
                                <ui:VisualElement class="table-editor__icon table-editor__icon--match-case" />
                            </ui:Button>
                            <ui:Button
                                name="table-editor__search-regex-toggle"
                                class="table-editor__icon-button table-editor__option-toggle"
                                tooltip="Use regular expression">
                                <ui:VisualElement class="table-editor__icon table-editor__icon--regex" />
                            </ui:Button>
                            <ui:Button
                                name="table-editor__search-word-toggle"
                                class="table-editor__icon-button table-editor__option-toggle"
                                tooltip="Match whole word">
                                <ui:VisualElement class="table-editor__icon table-editor__icon--match-word" />
                            </ui:Button>
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button
                        name="table-editor__search-next-button"
                        class="table-editor__icon-button"
                        tooltip="Next match (Enter, F3)">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--next" />
                    </ui:Button>
                    <ui:Button
                        name="table-editor__search-previous-button"
                        class="table-editor__icon-button"
                        tooltip="Previous match (Shift+Enter, Shift+F3)">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--previous" />
                    </ui:Button>
                    <ui:Button
                        name="table-editor__search-selection-toggle"
                        class="table-editor__icon-button table-editor__option-toggle"
                        tooltip="Find in selection">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--selection" />
                    </ui:Button>
                    <ui:Button
                        name="table-editor__search-vertical-toggle"
                        class="table-editor__icon-button table-editor__option-toggle"
                        tooltip="Search vertically (column by column, top to bottom)">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--vertical" />
                    </ui:Button>

                    <ui:Label name="table-editor__search-count" class="table-editor__search-count" text="" />
                    <ui:VisualElement class="table-editor__toolbar-spacer" />

                    <ui:Button
                        name="table-editor__search-close-button"
                        class="table-editor__icon-button"
                        tooltip="Close (Esc)">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--close" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement
                    name="table-editor__replace-row"
                    class="table-editor__search-row table-editor__replace-row--hidden">
                    <ui:VisualElement class="table-editor__search-input table-editor__search-input--single-option">
                        <ui:TextField name="table-editor__replace-field" class="table-editor__search-field" />
                        <ui:VisualElement class="table-editor__search-input-options">
                            <ui:Button
                                name="table-editor__replace-preserve-case-toggle"
                                class="table-editor__icon-button table-editor__option-toggle table-editor__text-toggle"
                                text="AB"
                                tooltip="Preserve case" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Button
                        name="table-editor__replace-button"
                        class="table-editor__icon-button"
                        tooltip="Replace (Enter)">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--replace" />
                    </ui:Button>
                    <ui:Button
                        name="table-editor__replace-all-button"
                        class="table-editor__icon-button"
                        tooltip="Replace all (Ctrl/Cmd+Enter)">
                        <ui:VisualElement class="table-editor__icon table-editor__icon--replace-all" />
                    </ui:Button>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 저장하지 않은 편집이 있는데 에디터 밖에서 파일이 바뀌면 띄운다. 편집이 없으면 묻지 않고 바로 다시 읽는다. -->
        <ui:VisualElement
            name="table-editor__external-change-bar"
            class="table-editor__external-change-bar table-editor__external-change-bar--hidden">
            <ui:VisualElement class="table-editor__icon table-editor__icon--info" />
            <ui:Label
                class="table-editor__external-change-text"
                text="The file was changed outside the editor. You have unsaved edits." />
            <ui:VisualElement class="table-editor__toolbar-spacer" />
            <ui:Button
                name="table-editor__external-change-reload-button"
                class="table-editor__bar-button"
                text="Reload"
                tooltip="Discard unsaved edits and read the changed file." />
            <ui:Button
                name="table-editor__external-change-dismiss-button"
                class="table-editor__bar-button"
                text="Ignore"
                tooltip="Keep your edits. You will be asked whether to overwrite when you save." />
        </ui:VisualElement>

        <ui:VisualElement class="table-editor__body">
            <ui:VisualElement
                name="table-editor__grid-container"
                class="table-editor__grid-container" />
            <ui:Button
                name="table-editor__add-column-button"
                class="table-editor__add-button table-editor__add-column-button"
                text="+"
                tooltip="Add a column at the far right." />
        </ui:VisualElement>

        <ui:Button
            name="table-editor__add-row-button"
            class="table-editor__add-button table-editor__add-row-button"
            text="+"
            tooltip="Add a row at the bottom." />

        <!-- 상태 표시줄: 왼쪽은 표 크기·활성 셀, 오른쪽은 파일 형식(인코딩·개행·구분 기호). -->
        <ui:VisualElement name="table-editor__status-bar" class="table-editor__status-bar">
            <ui:Label
                name="table-editor__status-size"
                class="table-editor__status-label"
                text="—" />
            <ui:Label
                name="table-editor__status-position"
                class="table-editor__status-label"
                text="—" />
            <ui:VisualElement class="table-editor__toolbar-spacer" />
            <ui:Label
                name="table-editor__status-state"
                class="table-editor__status-label"
                text="" />
            <ui:Label
                name="table-editor__status-encoding"
                class="table-editor__status-label"
                tooltip="File encoding. Kept as is when saving."
                text="" />
            <ui:Label
                name="table-editor__status-newline"
                class="table-editor__status-label"
                tooltip="Line ending. Kept as is when saving."
                text="" />
            <ui:Label
                name="table-editor__status-delimiter"
                class="table-editor__status-label"
                tooltip="Delimiter and quoting rule. Quotes are added only to cells that contain the delimiter, a quote or a line break."
                text="" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
